rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 呼叫者權限（讀自己的 users 文件；一律 .get(key,default) 避免缺欄位讓規則報錯）──
    function myPerm() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permission', '')
        : '';
    }
    function isOwnerOrAdmin() { return myPerm() in ['admin', 'owner']; }
    function isManagerUp() { return myPerm() in ['manager', 'admin', 'owner']; }
    function myStore() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('store', '')
        : '';
    }

    // ── users：員工 profile（2026-09-16 收緊）────────────
    // ⚠️ 2026-09-15 用測試帳號實測：舊規則被最下面的 catch-all 架空，任何登入者都能改「自己或別人」的
    //    permission／disabled（實測成功）。修法＝這個集合必須被 catch-all 排除（見檔案最下方），
    //    再由這裡定義誰能改什麼。
    // ・本人：只能改下面白名單欄位。role/store 只准套用成管理者事先排定的 pendingRole/pendingStore
    //   （auth.js _loadProfile 的生效日自動套用會走這條）。
    // ・店長：可改本店員工的一般欄位，但不得動 permission／disabled／ID／empName（防自行升權）。
    // ・加盟主／admin：不限。
    // ・Cloud Functions 走 Admin SDK，不受規則限制（adminResetPassword 補建 users 等）。
    function selfEditableKeys() {
      return ['homeFavs', 'homeTour', 'pushInvite', 'a2hsInvite', 'appUsage', 'pwdChanged', 'linked',
              'role', 'store', 'pendingRole', 'pendingStore', 'roleChangeDate', 'transferDate'];
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function selfPendingApplyOk() {
      return (!changedKeys().hasAny(['role']) || request.resource.data.get('role', '') == resource.data.get('pendingRole', ''))
        && (!changedKeys().hasAny(['store']) || request.resource.data.get('store', '') == resource.data.get('pendingStore', ''));
    }
    function managerTargetOk() {
      return (resource.data.get('store', '') == myStore() || request.resource.data.get('store', '') == myStore())
        && !changedKeys().hasAny(['permission', 'disabled', 'ID', 'empName']);
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwnerOrAdmin()
                    || (isManagerUp() && request.resource.data.get('store', '') == myStore()
                        && request.resource.data.get('permission', '') in ['employee', 'manager']);
      allow update: if isOwnerOrAdmin()
                    || (isManagerUp() && managerTargetOk())
                    || (request.auth != null && request.auth.uid == uid
                        && changedKeys().hasOnly(selfEditableKeys()) && selfPendingApplyOk());
      allow delete: if isOwnerOrAdmin();
    }

    // ── account：舊集合，遷移期保留（2026-09-16 收緊）──
    // 明文密碼欄位已於 2026-09-16 全部刪除；仍含工號/姓名/門市/職稱/權限，且多頁會整份載入瀏覽器，
    // 故維持「登入可讀」，但寫入只開放店長以上（原本任何員工都能改自己的權限）。
    match /account/{doc} {
      allow read: if request.auth != null;
      allow write: if isManagerUp();
    }

    // ── sharedReviews：營運檢討分享快照，公開讀但「僅在到期前」（過期後資料庫直接擋讀）──
    // 建立/覆寫由 catch-all(登入即可)處理；此處額外開放「未登入公開讀取」給分享連結對象。
    match /sharedReviews/{token} {
      allow read: if request.time < resource.data.expiresAt;
    }

    // ── inspectionSheets：盤點資料 ───────────────────────
    // 店長以上可讀；但店長只能改／刪**自己建立的**（ownerUid == 自己），加盟主以上不限。
    // ⚠️ 只擋介面沒有用：開 console 就能直接寫 Firestore，所以權限一定要落在這裡。
    // ⚠️ 一律用 .get(key, default)：直接存取不存在的欄位會讓規則報錯→拒絕整條（專案舊傷）。
    //    舊資料若沒有 ownerUid，店長會被擋下（安全的預設），由加盟主處理。
    match /inspectionSheets/{sheetId} {
      function perm() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permission', '');
      }
      function isOwnerUp() { return perm() in ['owner', 'admin']; }
      function isMine()    { return resource.data.get('ownerUid', '') == request.auth.uid; }

      allow read: if request.auth != null && perm() in ['manager', 'owner', 'admin'];

      allow create: if request.auth != null && perm() in ['manager', 'owner', 'admin']
                    && (isOwnerUp() || request.resource.data.get('ownerUid', '') == request.auth.uid);

      // 店長改自己的可以，但不能把 ownerUid 改成別人（等於偷換擁有者）
      allow update: if request.auth != null
                    && (isOwnerUp() ||
                        (perm() == 'manager' && isMine()
                         && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')));

      allow delete: if request.auth != null && (isOwnerUp() || (perm() == 'manager' && isMine()));
    }

    // ── city*：CITY手順（每週同步 → admin 確認後發佈）──────
    // 做法是全店通用內容，員工只能讀已發佈的；待確認／不收／不發佈／圖片紀錄／同步狀態只有 admin 看得到。
    // 所有寫入只有 admin（同步函式走 Admin SDK 不受規則限制）。
    // ⚠️ catch-all 下面用 coll.matches('city[A-Z].*') 排除，否則這裡的限制會被架空（同 inspectionSheets）。
    function isCityAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permission', '') == 'admin';
    }
    match /cityRecipes/{id} {
      allow read: if request.auth != null;
      allow write: if isCityAdmin();
    }
    match /citySpecs/{id} {
      allow read: if request.auth != null;
      allow write: if isCityAdmin();
    }
    match /{cityColl}/{id} {
      allow read, write: if cityColl in ['cityPending', 'cityIgnored', 'cityDeclined', 'cityImages', 'cityMeta'] && isCityAdmin();
    }

    // ── pushSubs：PWA 推播訂閱（2026-09-15）──────────────
    // 寫入一律經 Cloud Functions（pushSubscribe／pushUnsubscribe，Admin SDK 略過規則），前端不直接寫；
    // 只開放 admin 讀，給設定頁統計「誰開了推播」。catch-all 已排除此集合（見下方說明）。
    match /pushSubs/{id} {
      allow read: if isCityAdmin();
    }

    // ── 其他所有集合：登入即可讀寫 ───────────────────────
    // 涵蓋 settings, stores(含 weeks/salary/employees/attendance/attendanceRequests…),
    //      leaves/comp/leaveBatches/leaveLog/annualUsage/compUsage, lineBindings…
    //
    // ⚠️ Firestore 規則是「或」的關係，不是「覆蓋」：只要有任何一條 match 放行就放行。
    //    所以這條 catch-all 會把上面 inspectionSheets 的限制整個架空
    //    （任何登入者都能 read/update/delete 任何文件）。要真的擋住，唯一的辦法是
    //    讓 catch-all「配不到」那個集合 —— 故改成綁第一段集合名 {coll} 後排除。
    //    ⚠️ 2026-09-16 補排除 users／account：先前它們被這條架空，員工可用 console 改自己或別人的
    //       permission（已用測試帳號實測成功）。排除後才由上面各自的 match 生效。
    //    其餘集合的行為與原本完全相同。
    // ── storeMemos：門市備忘（客訂／留貨單，2026-09-25）───────────
    // 含客人電話 → 只有該門市的人讀得到（加盟主／admin 可看全部）。
    // 全店員工可建單、推進狀態；門市不可改；刪除限店長以上。
    // ⚠️ 必須被最下面的 catch-all 排除，否則任何登入者都能讀寫（users 的教訓）。
    match /storeMemos/{id} {
      function memoStoreOk(st) { return st != '' && (st == myStore() || isOwnerOrAdmin()); }
      allow read: if request.auth != null && memoStoreOk(resource.data.get('store', ''));
      allow create: if request.auth != null && memoStoreOk(request.resource.data.get('store', ''))
                    && request.resource.data.get('status', -1) in [0, 1, 2, 3];
      allow update: if request.auth != null && memoStoreOk(resource.data.get('store', ''))
                    && request.resource.data.get('store', '') == resource.data.get('store', '')
                    && request.resource.data.get('status', -1) in [0, 1, 2, 3];
      allow delete: if request.auth != null && isManagerUp() && memoStoreOk(resource.data.get('store', ''));
    }

    // ── stores：門市與其子集合（2026-10-10 為了收緊 salary 從 catch-all 拆出來）──
    // stores/{店} 本身與 salary 以外的子集合（weeks/attendance/employees/pnl…）規則與 catch-all 完全相同。
    // ⚠️ 不能只在 catch-all 加條件：Firestore 規則是「或」，catch-all 配得到 stores/*/salary 就會放行，
    //    所以 catch-all 必須排除 'stores'，再由下面三條接手。
    match /stores/{st} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.get('source', '') != 'app';
    }
    match /stores/{st}/{sub}/{rest=**} {
      allow read, update, delete: if request.auth != null && sub != 'salary';
      allow create: if request.auth != null && sub != 'salary' && request.resource.data.get('source', '') != 'app';
    }
    // ── salary：一個月一份、records[] 含全店員工薪資 ──
    // 原本走 catch-all＝任何登入者都能讀（員工開 console 就看得到全店同事薪資）、甚至能改。
    // ・讀：店長以上（含別店——薪資頁算「跨店支援費率」要讀支援人員原店的記錄，見 salary-page.js fetchSupportInRates）
    //   員工看自己的薪資一律走 Cloud Function getMySalary（只回本人那筆）。
    // ・寫：店長只能寫本店；加盟主／admin 不限。發薪排程等走 Admin SDK 不受影響。
    match /stores/{st}/salary/{ym} {
      allow read: if isManagerUp();
      allow write: if isOwnerOrAdmin() || (myPerm() == 'manager' && st == myStore());
    }

    // ── 團購系統 gb_*（2026-10-10 第 1 階段：後台基礎）──────────────
    // 規格書只留本機（docs/groupbuy-spec.md，不進公開 repo）。門市在 gb_ 一律用代碼 meide/lianxin/jinhua，
    // 使用者資料存的是中文店名，規則用下面的對照表換算。
    // ⚠️ 必須被最下面的 catch-all 排除（!coll.matches('gb_.*')），否則任何登入者都能讀寫訂單。
    function gbCodeOf(name) { return {'美德': 'meide', '聯鑫': 'lianxin', '錦花': 'jinhua'}.get(name, ''); }
    function gbMyCode() { return gbCodeOf(myStore()); }
    function gbStaff() {
      return request.auth != null
        && myPerm() in ['employee', 'manager', 'owner', 'admin']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }
    // 店長只能開／改「只開放自己店」的團購；跨店共用庫存的團只有加盟主／admin（使用者 2026-10-10 定案）
    function gbMgrOwnOnly(stores) { return myPerm() == 'manager' && gbMyCode() != '' && stores == [gbMyCode()]; }
    function gbCampaign(cid) { return get(/databases/$(database)/documents/gb_campaigns/$(cid)).data; }

    // gb_campaigns：開放中的團購任何人可讀（LIFF 前台查詢必須帶 status == "open"，直接比對欄位才會強制）；
    // 員工可讀全部；建立／編輯：加盟主／admin 不限、店長限本店專屬團；
    // 補單時員工／店長可在 transaction 裡只更新 ordered_qty／ordered_by_store（各店已訂數量，列表用），
    // 且不得超過庫存、只限有開放給本店的團。
    match /gb_campaigns/{cid} {
      allow read: if resource.data.status == 'open' || gbStaff();
      allow create: if isOwnerOrAdmin() || gbMgrOwnOnly(request.resource.data.get('available_stores', []));
      allow update: if isOwnerOrAdmin()
                    || (gbMgrOwnOnly(resource.data.get('available_stores', [])) && gbMgrOwnOnly(request.resource.data.get('available_stores', [])))
                    || (gbStaff() && changedKeys().hasOnly(['ordered_qty', 'ordered_by_store', 'updated_at'])
                        && gbMyCode() in resource.data.get('available_stores', [])
                        && request.resource.data.ordered_qty is int && request.resource.data.ordered_qty >= 0
                        && (resource.data.get('stock', null) == null || request.resource.data.ordered_qty <= resource.data.stock));
      allow delete: if isOwnerOrAdmin()
                    || (gbMgrOwnOnly(resource.data.get('available_stores', [])) && resource.data.get('status', '') == 'draft');
    }

    // gb_orders：員工／店長只能讀寫本店訂單，加盟主／admin 不限；客人（未登入）完全不可存取。
    // 補單限開放中的團（截單後只有加盟主／admin 可補）；改數量、取消同樣限開放中，
    // 截單後員工只能做取貨相關的更新（已取貨／已付款／棄單）。
    function gbOrderStoreOk(st) { return isOwnerOrAdmin() || (gbStaff() && st != '' && st == gbMyCode()); }
    function gbPickupOnly() {
      return changedKeys().hasOnly(['status', 'paid', 'picked_up_at', 'picked_up_by', 'no_show_at', 'no_show_by', 'updated_at'])
        && request.resource.data.get('status', '') in ['active', 'picked_up', 'no_show'];
    }
    match /gb_orders/{oid} {
      allow read: if gbOrderStoreOk(resource.data.store);
      allow create: if gbOrderStoreOk(request.resource.data.get('store', ''))
                    && request.resource.data.get('source', '') == 'manual'
                    && request.resource.data.get('created_by', '') == request.auth.uid
                    && request.resource.data.qty is int && request.resource.data.qty > 0
                    && request.resource.data.qty <= gbCampaign(request.resource.data.campaign_id).get('per_user_limit', 999)
                    && request.resource.data.store in gbCampaign(request.resource.data.campaign_id).get('available_stores', [])
                    && (isOwnerOrAdmin() || gbCampaign(request.resource.data.campaign_id).get('status', '') == 'open');
      allow update: if gbOrderStoreOk(resource.data.store)
                    && request.resource.data.get('store', '') == resource.data.store
                    && request.resource.data.get('campaign_id', '') == resource.data.get('campaign_id', '')
                    && (!changedKeys().hasAny(['qty']) || (request.resource.data.qty is int && request.resource.data.qty > 0
                        && request.resource.data.qty <= gbCampaign(resource.data.campaign_id).get('per_user_limit', 999)))
                    && (isOwnerOrAdmin() || gbCampaign(resource.data.campaign_id).get('status', '') == 'open' || gbPickupOnly());
      allow delete: if isOwnerOrAdmin();
    }

    // gb_customers：員工可讀；棄單時員工只能動棄單相關欄位（客人資料由第 2 階段的下單 API 寫入）
    match /gb_customers/{uid} {
      allow read: if gbStaff();
      allow create, update: if isOwnerOrAdmin()
                    || (gbStaff() && request.resource.data.keys().hasOnly(['no_show_count', 'last_no_show_at', 'display_name', 'picture_url', 'last_order_at'])
                        && (resource == null || changedKeys().hasOnly(['no_show_count', 'last_no_show_at'])));
      allow delete: if isOwnerOrAdmin();
    }

    // gb_settings：員工可讀（門市代碼）；只有加盟主／admin 可改
    // 第 4 階段（群組 +1 機器人）：寫入一律經 Cloud Functions（Admin SDK）；前端只讀
    // gb_bot_groups：機器人所在群組白名單（加盟主／admin 看）；gb_pending_plus：判斷不了的 +1（員工只看本店）；gb_post_map：不給前端
    match /gb_bot_groups/{gid} {
      allow read: if isOwnerOrAdmin();
    }
    match /gb_pending_plus/{pid} {
      allow read: if isOwnerOrAdmin() || (gbStaff() && resource.data.store == gbMyCode() && gbMyCode() != '');
    }

    // gb_settings/liff（liff_id、channel_id，都不是密碼）開放未登入讀：LIFF 客人頁要拿 liff_id 初始化
    match /gb_settings/{doc} {
      allow read: if doc == 'liff' || gbStaff();
      allow write: if isOwnerOrAdmin();
    }

    match /{coll}/{docPath=**} {
      allow read: if request.auth != null && coll != 'inspectionSheets' && coll != 'pushSubs' && coll != 'stores' && !coll.matches('gb_.*') && coll != 'users' && coll != 'account' && coll != 'storeMemos' && !coll.matches('city[A-Z].*');
      allow update, delete: if request.auth != null && coll != 'inspectionSheets' && coll != 'pushSubs' && coll != 'stores' && !coll.matches('gb_.*') && coll != 'users' && coll != 'account' && coll != 'storeMemos' && !coll.matches('city[A-Z].*');
      // 打卡防偽：source=="app" 的打卡「只能」由 clockPunch callable(Admin SDK 略過規則)建立；
      //          客戶端不可直接寫入假打卡。管理者補登(source=manual)、缺卡(source=system)、其他無 source 的建立照常。
      // ⚠️ 必須用 .get('source','')：直接存取不存在的欄位會讓規則報錯而「拒絕」→ 會擋掉所有沒有 source 欄位的建立(薪資簽收/劃休/綁定…)
      allow create: if request.auth != null && coll != 'inspectionSheets' && coll != 'pushSubs' && coll != 'stores' && !coll.matches('gb_.*') && coll != 'users' && coll != 'account' && coll != 'storeMemos' && !coll.matches('city[A-Z].*')
                    && request.resource.data.get('source', '') != 'app';
    }
  }
}
